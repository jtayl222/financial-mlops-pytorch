 — Team visibility into ongoing experiments","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":13,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:61a4db94e6bb_53":{"__typename":"Paragraph","id":"61a4db94e6bb_53","name":"aa85","type":"PRE","href":null,"layout":null,"metadata":null,"text":"# Monitor live training experiments\n.\u002Fscripts\u002Frun-live-ab-dashboard.sh","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":{"__typename":"CodeBlockMetadata","mode":"EXPLICIT","lang":"bash"},"iframe":null,"mixtapeMetadata":null},"Paragraph:61a4db94e6bb_54":{"__typename":"Paragraph","id":"61a4db94e6bb_54","name":"aab0","type":"P","href":null,"layout":null,"metadata":null,"text":"2. Seldon Production Dashboard","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":30,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:61a4db94e6bb_55":{"__typename":"Paragraph","id":"61a4db94e6bb_55","name":"63ed","type":"P","href":null,"layout":null,"metadata":null,"text":"Purpose: Monitor live A\u002FB test business impact","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":7,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:61a4db94e6bb_56":{"__typename":"Paragraph","id":"61a4db94e6bb_56","name":"03da","type":"ULI","href":null,"layout":null,"metadata":null,"text":"Traffic Distribution — Real-time 70\u002F30 split monitoring","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":20,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":